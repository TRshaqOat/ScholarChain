# r01 Part B check script (run with bash; scratchpad copy)
#!/usr/bin/env bash
# r01 Part B offline checks. No git, aws, terraform or live run.
set -u
R=/Users/achyutpatel/Developer/Cloud/ScholarChain
S=/private/tmp/claude-501/-Users-achyutpatel-Developer-Cloud-ScholarChain/357bb839-b6d7-4ed2-9a8d-b9f85b7147b7/scratchpad
L=$R/scratch/phase-15-logs
H=load-tests/exp-d-query-load.py
V1=(--levels 1,2,4,8 --level-seconds 180 --pause-seconds 30 --post-observe-seconds 120 --abort-error-rate 0.05 --abort-window-seconds 10 --abort-min-requests 20 --abort-consecutive 10)
DS=(--levels 8 --level-seconds 600 --pause-seconds 0 --post-observe-seconds 1500 --abort-error-rate 0.05 --abort-window-seconds 10 --abort-min-requests 20 --abort-consecutive 10 --max-requests-per-level 40000 --poll-seconds 30)
cp "$R/$H" "$S/post/$H"

# 1. self-test of the repaired harness (in the repository)
{
  echo "\$ sha256 $H"; shasum -a 256 "$R/$H" | cut -d' ' -f1
  echo "\$ time python3 -I $H --self-test"
  cd "$R" && { time python3 -I "$H" --self-test; } 2>&1; echo "exit=$?"
} >"$L/r01-b-self-test.log" 2>&1

# 2. mutations: each removes one part of the m3 repair; the self-test must fail
mut() {  # name, old, new
  mkdir -p "$S/mut-$1/load-tests"
  python3 -I -c 'import sys; p,o,n=sys.argv[1:]; s=open(p).read(); assert s.count(o)>=1, o; open(sys.argv[1].replace("/post/","/mut-'"$1"'/"),"w").write(s.replace(o,n))' \
    "$S/post/$H" "$2" "$3"
  echo "--- mutation $1: $4 ---"
  python3 -I "$S/mut-$1/$H" --self-test 2>&1 | tail -3; echo "exit=${PIPESTATUS[0]}"
  echo "failing assertion:"
  python3 -I -c 'import importlib.util as u, sys, traceback; sp = u.spec_from_file_location("h", sys.argv[1]); m = u.module_from_spec(sp); sp.loader.exec_module(m)
try:
    m.self_test()
except AssertionError:
    traceback.print_exc(limit=-1)' "$S/mut-$1/$H" 2>&1 | grep -v '^Traceback' | head -4
}
{
  mut a "ecs_timeout = POLL_CALL_TIMEOUT_S if a.poll_seconds else None" "ecs_timeout = None" "no subprocess timeout for ecs_counts in D-scale"
  mut b "ecs_timeout = POLL_CALL_TIMEOUT_S if a.poll_seconds else None" "ecs_timeout = POLL_CALL_TIMEOUT_S" "timeout also in v1"
  mut c "    except subprocess.TimeoutExpired:  # only possible when timeout is set
        r, err = None, \"TimeoutExpired\"" "    except ZeroDivisionError:
        r, err = None, \"TimeoutExpired\"" "ecs_counts timeout not caught"
  mut d "        index.append({\"name\": name, \"file\": fn, \"at\": at, \"error\": err})
        save()" "        index.append({\"name\": name, \"file\": fn, \"at\": at, \"error\": err})" "collect.json not written after each call"
  mut e "                      \"error\": \"no target-tracking alarm names in collect-scaling-policies.json\"})
        save()" "                      \"error\": \"no target-tracking alarm names in collect-scaling-policies.json\"})" "collect.json not written after the no-alarm entry"
} >"$L/r01-b-mutations.log" 2>&1

# 3. v1 dry-run, pre-repair (work order 3 state) against repaired; D-scale dry-run likewise
{
  mkdir -p "$S/cmp/load-tests"; ln -sfn "$R/operations" "$S/cmp/operations"
  for side in pre post; do  # same path for both sides, so only the harness differs
    cp "$S/$side/$H" "$S/cmp/$H"
    python3 -I "$S/cmp/$H" --dry-run "${V1[@]}" >"$S/$side-v1.out" 2>&1; echo "$side v1 dry-run exit=$?"
    python3 -I "$S/cmp/$H" --dry-run "${DS[@]}" >"$S/$side-ds.out" 2>&1; echo "$side d-scale dry-run exit=$?"
  done
  echo "\$ diff <pre-repair v1 dry-run> <repaired v1 dry-run>  (v1 manifest args)"
  diff "$S/pre-v1.out" "$S/post-v1.out" && echo IDENTICAL
  echo "\$ diff <pre-repair d-scale dry-run> <repaired d-scale dry-run>  (exp-d-scale-v1 args)"
  diff "$S/pre-ds.out" "$S/post-ds.out"; echo "diff exit=$?"
  echo "\$ cat <repaired v1 dry-run>"; cat "$S/post-v1.out"
} >"$L/r01-b-dry-run-v1-diff.log" 2>&1

# 4. manifests: JSON, run-experiment.sh checks, and run-experiment.sh --dry-run for both
{
  cd "$R"
  echo "\$ jq empty experiments/manifests/exp-d-scale-v1.json"; jq empty experiments/manifests/exp-d-scale-v1.json; echo "exit=$?"
  echo "\$ jq '.limits | {maxMinutes, plannedMinutes, collectBudgetSeconds}' experiments/manifests/exp-d-scale-v1.json"
  jq -c '.limits | {maxMinutes, plannedMinutes, collectBudgetSeconds}' experiments/manifests/exp-d-scale-v1.json
  echo "\$ diff <pre-repair manifest> experiments/manifests/exp-d-scale-v1.json"
  diff "$S/pre/exp-d-scale-v1.json" experiments/manifests/exp-d-scale-v1.json; echo "diff exit=$?"
  for m in exp-d-scale-v1 exp-d-query-load-v1; do
    echo "\$ scripts/run-experiment.sh --manifest experiments/manifests/$m.json --dry-run"
    scripts/run-experiment.sh --manifest "experiments/manifests/$m.json" --dry-run 2>&1; echo "exit=$?"
  done
  echo "\$ test -e load-tests/__pycache__"; if test -e load-tests/__pycache__; then echo "present"; else echo "absent"; fi
} >"$L/r01-b-run-experiment-dry-run.log" 2>&1
echo done
