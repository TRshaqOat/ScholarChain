{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planner-output-v1",
  "title": "ScholarChain query planner output (modules/rag/RUNTIME.md section 3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operations", "researcherNames", "metrics", "window", "comparison", "topics", "venues", "institutions"],
  "properties": {
    "schemaVersion": {"const": "planner-output-v1"},
    "operations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "scope", "researchers", "metric", "topN"],
        "properties": {
          "operation": {"enum": ["RESEARCHER_RANKING", "MAXIMUM_TEAM_SIZE", "DIRECT_COAUTHORS", "SHORTEST_PATH", "COMPONENT_LOOKUP", "COMMUNITY_COMPARISON", "BRIDGE_RANKING", "TEMPORAL_COMPARISON", "TOPIC_FILTER", "VENUE_FILTER", "INSTITUTION_FILTER", "SEMANTIC_EXPLANATION"]},
          "scope": {"enum": ["RESEARCHER", "PAIR", "CORPUS"]},
          "researchers": {"type": "array", "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 20}},
          "metric": {"type": ["string", "null"], "enum": ["PUBLICATION_COUNT", "DISTINCT_COAUTHOR_COUNT", "TOTAL_COAUTHOR_OCCURRENCES", "AVERAGE_COAUTHORS_PER_PAPER", "MAXIMUM_COAUTHORS_ON_ONE_PAPER", "WEIGHTED_DEGREE", "COMPONENT_SIZE", "CROSS_COMMUNITY_DEGREE", "COMMUNITIES_CONNECTED", "PARTICIPATION_COEFFICIENT", "CORENESS"]},
          "topN": {"type": ["integer", "null"], "minimum": 1, "maximum": 100000}
        }
      }
    },
    "researcherNames": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "metrics": {
      "type": "array",
      "maxItems": 11,
      "items": {"enum": ["PUBLICATION_COUNT", "DISTINCT_COAUTHOR_COUNT", "TOTAL_COAUTHOR_OCCURRENCES", "AVERAGE_COAUTHORS_PER_PAPER", "MAXIMUM_COAUTHORS_ON_ONE_PAPER", "WEIGHTED_DEGREE", "COMPONENT_SIZE", "CROSS_COMMUNITY_DEGREE", "COMMUNITIES_CONNECTED", "PARTICIPATION_COEFFICIENT", "CORENESS"]}
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "yearFrom", "yearTo"],
      "properties": {
        "kind": {"enum": ["DEFAULT", "NAMED", "RANGE"]},
        "name": {"type": ["string", "null"], "maxLength": 100},
        "yearFrom": {"type": ["integer", "null"], "minimum": 1000, "maximum": 9999},
        "yearTo": {"type": ["integer", "null"], "minimum": 1000, "maximum": 9999}
      }
    },
    "comparison": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["fromWindow", "toWindow"],
      "properties": {
        "fromWindow": {"type": "string", "maxLength": 100},
        "toWindow": {"type": "string", "maxLength": 100}
      }
    },
    "topics": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "venues": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "institutions": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  }
}
